{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["Components/**/*.ts"]
}
