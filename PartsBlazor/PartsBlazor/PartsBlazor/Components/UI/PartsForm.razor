@using PartsBlazor.Models
@using PartsBlazor.Services
@using System.ComponentModel.DataAnnotations
@inject PartsService PartsService

@rendermode InteractiveServer

<div class="modal-overlay" @onmousedown="@(() => mouseDownOnOverlay = true)" @onclick="HandleOverlayClick">
    <div class="modal-content" @onclick:stopPropagation @onmousedown:stopPropagation>
        <div class="modal-header">
            <h3>@(Part?.Id == null ? "Add Part" : "Edit Part")</h3>
            <button class="close-btn" @onclick="OnCancel">✕</button>
        </div>

        <form @onsubmit="HandleSubmit">
            <div class="form-group">
                <label id="sku-label">SKU *</label>
                <div class="autocomplete">
                    <input type="text" value="@Part.Sku" disabled="@isSubmitting"
                           placeholder="e.g., ABC-001" autocomplete="off"
                           role="combobox" aria-autocomplete="list" aria-labelledby="sku-label"
                           aria-expanded="@(ShowSuggestions ? "true" : "false")" aria-controls="sku-suggestions"
                           aria-activedescendant="@(activeIndex >= 0 ? $"sku-suggestion-{activeIndex}" : null)"
                           @oninput="OnSkuInput" @onkeydown="OnSkuKeyDown"
                           @onfocus="OnSkuFocus" @onblur="CloseSuggestions" />
                    @if (ShowSuggestions)
                    {
                        <ul class="suggestions" id="sku-suggestions" role="listbox" @onmousedown:preventDefault>
                            @for (var i = 0; i < suggestions.Count; i++)
                            {
                                var index = i;
                                var suggestion = suggestions[i];
                                <li class="suggestion @(index == activeIndex ? "active" : "")"
                                    id="sku-suggestion-@index" role="option"
                                    aria-selected="@(index == activeIndex ? "true" : "false")"
                                    @onclick="() => SelectSuggestion(suggestion)"
                                    @onmouseover="() => activeIndex = index">
                                    <span class="suggestion-sku">@suggestion.Sku</span>
                                    <span class="suggestion-name">@suggestion.Name</span>
                                    <span class="suggestion-category">@suggestion.Category</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
                @if (!IsValidSku())
                {
                    <span class="error">SKU is required and must be 3-20 characters</span>
                }
            </div>

            <div class="form-group">
                <label>Name *</label>
                <input type="text" @bind="Part.Name" disabled="@isSubmitting" 
                       placeholder="e.g., Bearing A1" />
                @if (!IsValidName())
                {
                    <span class="error">Name is required and max 80 characters</span>
                }
            </div>

            <div class="form-group">
                <label>Category *</label>
                <select @bind="Part.Category" disabled="@isSubmitting">
                    <option value="">-- Select --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
                @if (string.IsNullOrEmpty(Part.Category))
                {
                    <span class="error">Category is required</span>
                }
            </div>

            <div class="form-group">
                <label>Price ($) *</label>
                <input type="number" @bind="Part.Price" disabled="@isSubmitting" 
                       placeholder="0.00" step="0.01" />
                @if (Part.Price <= 0)
                {
                    <span class="error">Price must be greater than 0</span>
                }
            </div>

            <div class="form-group">
                <label>Stock (Units) *</label>
                <input type="number" @bind="Part.Stock" disabled="@isSubmitting" 
                       placeholder="0" min="0" />
                @if (Part.Stock < 0)
                {
                    <span class="error">Stock cannot be negative</span>
                }
            </div>

            <div class="form-group checkbox">
                <input type="checkbox" @bind="Part.Active" disabled="@isSubmitting" />
                <label>Active</label>
            </div>

            <div class="form-actions">
                <button type="button" @onclick="OnCancel" disabled="@isSubmitting" class="btn-secondary">Cancel</button>
                <button type="submit" disabled="@(!IsFormValid() || isSubmitting)" class="btn-primary">
                    @(isSubmitting ? "Saving..." : "Save")
                </button>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter]
    public Part Part { get; set; } = new();

    [Parameter]
    public EventCallback<Part> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private List<string> categories = [];
    private bool isSubmitting = false;
    private bool mouseDownOnOverlay = false;

    private List<PartSuggestion> suggestions = [];
    private bool suggestionsOpen = false;
    private int activeIndex = -1;
    private bool suppressSubmit = false;

    private bool ShowSuggestions => suggestionsOpen && suggestions.Count > 0;

    private void OnSkuInput(ChangeEventArgs e)
    {
        Part.Sku = e.Value?.ToString() ?? "";
        suggestions = PartsService.SearchCatalog(Part.Sku);
        suggestionsOpen = true;
        activeIndex = -1;
    }

    private void OnSkuFocus()
    {
        suggestions = PartsService.SearchCatalog(Part.Sku);
        suggestionsOpen = suggestions.Count > 0;
        activeIndex = -1;
    }

    private void OnSkuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseSuggestions();
            return;
        }

        if (!ShowSuggestions)
        {
            // ArrowDown re-opens the list after Escape or a selection
            if (e.Key == "ArrowDown")
                OnSkuFocus();
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                activeIndex = (activeIndex + 1) % suggestions.Count;
                break;
            case "ArrowUp":
                activeIndex = activeIndex <= 0 ? suggestions.Count - 1 : activeIndex - 1;
                break;
            case "Enter" when activeIndex >= 0:
                // Take the highlighted suggestion instead of submitting the form
                suppressSubmit = true;
                SelectSuggestion(suggestions[activeIndex]);
                break;
            case "Tab":
                CloseSuggestions();
                break;
        }
    }

    private void SelectSuggestion(PartSuggestion suggestion)
    {
        Part.Sku = suggestion.Sku;
        Part.Name = suggestion.Name;
        Part.Category = suggestion.Category;
        CloseSuggestions();
    }

    private void CloseSuggestions()
    {
        suggestionsOpen = false;
        activeIndex = -1;
    }

    private async Task HandleOverlayClick()
    {
        if (!mouseDownOnOverlay) return;
        mouseDownOnOverlay = false;
        await OnCancel.InvokeAsync();
    }

    protected override void OnInitialized()
    {
        categories = PartsService.GetCategories();
        if (Part.Category == null)
            Part.Category = "";
    }

    private bool IsValidSku() => !string.IsNullOrWhiteSpace(Part.Sku) && 
                                 Part.Sku.Length >= 3 && Part.Sku.Length <= 20;
    
    private bool IsValidName() => !string.IsNullOrWhiteSpace(Part.Name) && 
                                  Part.Name.Length <= 80;
    
    private bool IsFormValid() => IsValidSku() && IsValidName() && 
                                  !string.IsNullOrEmpty(Part.Category) && 
                                  Part.Price > 0 && Part.Stock >= 0;

    private async Task HandleSubmit()
    {
        // Enter was used to pick a suggestion, not to save the form
        if (suppressSubmit)
        {
            suppressSubmit = false;
            return;
        }

        if (!IsFormValid()) return;

        isSubmitting = true;
        try
        {
            await OnSave.InvokeAsync(Part);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
