@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@* Renders nothing. Rendered once from MainLayout so every page records a visit
   in localStorage. See UserActivity.razor.ts for the storage format. *@

@code {
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/UI/UserActivity.razor.js");

        Navigation.LocationChanged += OnLocationChanged;
        await RecordVisit(Navigation.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() => RecordVisit(e.Location));
    }

    private async Task RecordVisit(string url)
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("recordPageVisit", url);
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-navigation; the next page load records it instead.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Nothing left to dispose on the client.
            }
        }
    }
}
